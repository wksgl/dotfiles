"8	CHAR	0
	SABLE_CONFIGURATION_WIZARD=true
	POWERLEVEL9K_PROMPT_ON_NEWLINE=false   # 单行
	POWERLEVEL9K_LEFT_PROMPT_ELEMENTS=(dir vcs) # 左侧目录 + Git
	POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS=(status command_execution_time) # 右侧状态 + 耗时
	
	# ---------- 左侧目录美化 ----------
	POWERLEVEL9K_DIR_HOME_FOREGROUND=39
	POWERLEVEL9K_DIR_HOME_BACKGROUND=236
	POWERLEVEL9K_DIR_DEFAULT_FOREGROUND=39
	POWERLEVEL9K_DIR_DEFAULT_BACKGROUND=235
	POWERLEVEL9K_DIR_HOME_SUBFOLDER_FOREGROUND=45
	POWERLEVEL9K_DIR_HOME_SUBFOLDER_BACKGROUND=235
	POWERLEVEL9K_DIR_DEFAULT_SUBFOLDER_FOREGROUND=45
	POWERLEVEL9K_DIR_DEFAULT_SUBFOLDER_BACKGROUND=235
	POWERLEVEL9K_SHORTEN_DIR_LENGTH=3
	POWERLEVEL9K_SHORTEN_STRATEGY="truncate_middle"
	
	# ---------- Git branch & status ----------
	POWERLEVEL9K_VCS_BRANCH_ICON=' '
	POWERLEVEL9K_VCS_BRANCH_FOREGROUND=33       # 蓝色
	POWERLEVEL9K_VCS_STATUS_OK_FOREGROUND=10    # 绿色
	POWERLEVEL9K_VCS_STATUS_CHANGED_FOREGROUND=214 # 黄色
	POWERLEVEL9K_VCS_STATUS_CONFLICT_FOREGROUND=196 # 红色
	POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=214
	POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=242
	
	# ---------- 命令成功/失败 ----------
	POWERLEVEL9K_STATUS_OK_FOREGROUND=10
	POWERLEVEL9K_STATUS_ERROR_FOREGROUND=196
	POWERLEVEL9K_STATUS_OK_PREFIX="✔ "
	POWERLEVEL9K_STATUS_ERROR_PREFIX="✖ "
	
	# ---------- 命令耗时 ----------
	POWERLEVEL9K_COMMAND_EXECUTION_TIME_THRESHOLD=3
	POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND=214
	POWERLEVEL9K_COMMAND_EXECUTION_TIME_PREFIX="⏱ "
	
	# ---------- Prompt symbol ----------
	POWERLEVEL9K_MULTILINE_FIRST_PROMPT_PREFIX=""
	POWERLEVEL9K_MULTILINE_LAST_PROMPT_PREFIX="❯ "
	
	# Load Powerlevel10k theme
	source ${ZIM_HOME}/modules/powerlevel10k/powerlevel10k.zsh-theme
	
