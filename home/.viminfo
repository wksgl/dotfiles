"5	CHAR	0
	# ------------------
	# Initialize Zim
	# ------------------
	eval "$(starship init zsh)"
	ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
	source ${ZIM_HOME}/init.zsh
	
	
	
	# ------------------
	# Initialize Zim
	# ------------------
	ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
	source ${ZIM_HOME}/init.zsh
	
	# -----------------
	# User configuration
	# -----------------
	setopt HIST_IGNORE_ALL_DUPS
	bindkey -v
	WORDCHARS=${WORDCHARS//[\/]}
	
	source fzf.zsh
